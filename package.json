{
  "name": "@damienmortini/lib",
  "version": "0.2.13",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "pnpm -r run build",
    "build:watch": "pnpm -r run build -- --watch",
    "prepare": "git config core.hooksPath hooks",
    "serve": "server",
    "bump": "lerna version patch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "git clean -fdX",
    "publish": "pnpm run build && lerna publish from-package --yes",
    "rewritepackagefiles": "node rewritepackagefiles.js",
    "start": "server --resolve-modules",
    "test": "node packages/worktree-setup/src/cli.ts --check && eslint packages && pnpm run typecheck && pnpm -r run test",
    "typecheck": "for project in packages/*/tsconfig.json; do tsc --noEmit --incremental false --project \"$project\" || exit 1; done",
    "update": "pnpm i",
    "upgrade": "syncpack update && syncpack fix && pnpm i",
    "version": "lerna version",
    "worktree:setup": "node packages/worktree-setup/src/cli.ts"
  },
  "dependencies": {
    "es-module-shims": "^2.8.1"
  },
  "devDependencies": {
    "@damienmortini/eslint-config": "workspace:*",
    "@damienmortini/server": "workspace:^",
    "@damienmortini/typescript-config": "workspace:^",
    "@damienmortini/worktree-setup": "workspace:*",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "10.5.0",
    "fast-glob": "^3.3.3",
    "jsdoc": "^4.0.5",
    "lerna": "^9.0.7",
    "sort-package-json": "4.0.0",
    "syncpack": "15.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "worktreeSetup": {
    "packageDirectories": [
      "packages"
    ],
    "requiredPackages": [
      "@damienmortini/eslint-config",
      "@damienmortini/typescript-config"
    ]
  }
}
