#!/bin/sh
# Lint what is about to be committed.
#
# Without this a lint error lands quietly and is found later by whoever runs
# `eslint --fix` over a whole package — as churn in the middle of their own diff, which
# they then have to unpick from it.
#
# Only the staged paths, never the whole tree: work in progress elsewhere in the tree is
# not this commit's business. It is the working copy of those paths that eslint reads and
# not the staged blob, so a partly staged file is judged by what is on disk rather than by
# what is about to be committed. Closing that gap means stashing the rest of the tree for
# the length of the hook, which is far more dangerous than the mismatch it fixes.
# `git commit --no-verify` goes past all of it.
#
# The linter and the config it loads both come from the checkout the working tree belongs
# to, never from the tree being committed: a linked worktree carries a checkout of the
# repository but none of its node_modules, and a commit made there would otherwise go
# unchecked. Silent when that checkout has no eslint installed, so a fresh clone that has
# not installed yet can still commit.

root=$(dirname "$(git rev-parse --git-common-dir)")
eslint="$root/node_modules/.bin/eslint"
[ -x "$eslint" ] || exit 0

# R as well as ACM: a rename carrying an edit is a staged change like any other, and
# --name-only reports it at the path it now has. The trailing -- keeps a file whose name
# begins with a dash from being read as a flag.
set -- '*.js' '*.mjs' '*.cjs' '*.ts' '*.mts' '*.cts'

# Asked separately rather than through xargs -r, which is a GNU extension: where it is not
# understood xargs fails whatever it was given, and every commit would be rejected as if
# the linter had spoken. --quiet answers with its exit status alone, so nothing here has to
# read a list to find out whether there is one.
git diff --cached --quiet --diff-filter=ACMR -- "$@" && exit 0

git diff --cached --name-only --diff-filter=ACMR -z -- "$@" \
  | xargs -0 "$eslint" --no-warn-ignored --config "$root/eslint.config.js" -- \
  || {
    echo 'pre-commit: eslint rejected the staged files above — fix them, or run: npx eslint --fix <file>...' >&2
    exit 1
  }
